<?xml version="1.0" encoding="utf-8" ?>

<Defs>
 
  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_Boomshot</defName>
    <label>Boomshot</label>
    <description>A simple pump action grenade launcher made for Boomers, Woefully inaccurate due to its poorly made ironsights. The Boomshots design is theorized to have originated from the UIR Booshka Grenade launcher.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_BoomshotGrenadeLauncher</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.15</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustboomers</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>3001</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>77500</WorkToMake>
      <Mass>7.5</Mass>
      <AccuracyTouch>0.50</AccuracyTouch>
      <AccuracyShort>0.30</AccuracyShort>
      <AccuracyMedium>0.20</AccuracyMedium>
      <AccuracyLong>0.10</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
	  <Chemfuel>125</Chemfuel>
    </costList>
    <weaponTags>
	 <li>LocustBoomshot</li>
    </weaponTags>
	<equippedStatOffsets>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Boomshot</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_GOW_Boomshot</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
		<targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>9</muzzleFlashScale>
		<forcedMissRadius>2.9</forcedMissRadius>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.1</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Boomshot</defName>
    <label>Boomshot Grenade</label>
	<thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>2</explosionRadius >
      <damageDef>Bomb</damageDef>
	  <damageAmountBase>15</damageAmountBase>
      <speed>30</speed>
    </projectile>
	<comps>
     <li Class="ProjectileEffecterGeneric.CompProperties_ProjectileEffecterGeneric">
      <effecterDef>Smoke_GOW_Ozz</effecterDef>
     </li>
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="MoteBase">
    <defName>Mote_GOW_Ozz</defName>
    <thingClass>MoteThrown</thingClass>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>0.75</solidTime>
      <fadeOutTime>0.7</fadeOutTime>
      <growthRate>0.47</growthRate>
      <acceleration>(0,0,0.0014)</acceleration>
    </mote>
  </ThingDef>

  <EffecterDef>
    <defName>Smoke_GOW_Ozz</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
        <moteDef>Mote_GOW_Ozz</moteDef>
        <ticksBetweenMotes>1</ticksBetweenMotes>
        <scale>0.40~0.50</scale>
        <absoluteAngle>true</absoluteAngle>
        <angle>30~70</angle>
        <speed>0.18~0.3</speed>
        <color>(0,0,0,1)</color>
      </li>
    </children>
  </EffecterDef>
  
  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_TorqueBow</defName>
    <label>Torque Bow</label>
    <description>An unusual coilgun designed to resemble an oversized crossbow, the Torque Bow launchs explosive bolts at extreme speeds. Typically this weapon has only been seen wielded by the personal army of the Queen, but its original purpose was for elite assassins known as Hunters to track down and eliminate priority targets.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_TorqueBow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.45</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustqueen</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <displayPriority>3002</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>98500</WorkToMake>
      <Mass>8.5</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.65</AccuracyShort>
      <AccuracyMedium>0.50</AccuracyMedium>
      <AccuracyLong>0.40</AccuracyLong>
      <RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>135</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
	  <Chemfuel>125</Chemfuel>
    </costList>
    <weaponTags>
	 <li>LocustTorqueBow</li>
    </weaponTags>
	<equippedStatOffsets>
      <MoveSpeed>-0.15</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_TorqueBow</defaultProjectile>
        <warmupTime>4.5</warmupTime>
        <range>29.9</range>
        <soundCast>Shot_GOW_TorqueBow</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
		<soundAiming>Shot_GOW_TorqueBow_Aiming</soundAiming>
		<targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>14</power>
		<soundMeleeHit>Shot_GOW_TorqueBowMelee</soundMeleeHit>
        <cooldownTime>2.3</cooldownTime>
      </li>
	  <li>
        <label>barrel</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <FleckDef ParentName="FleckBase">
    <defName>GW_Locust_TorqueFleck</defName>
    <altitudeLayer>Projectile</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.0</solidTime>
    <fadeOutTime>0.14</fadeOutTime>
    <graphicData>
      <texPath>Things/Projectile/GOW_TorquebowBeam</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1,1)</drawSize>
      <color>(150,150,150)</color>
    </graphicData>
  </FleckDef>

  <ThingDef ParentName="BaseBullet">
        <defName>Bullet_TorqueBow</defName>
        <label>Torque Arrow</label>
        <description>Arrow</description>
        <thingClass>MstToyBox.Mst_BezierProjectile_Explosive</thingClass>
        <drawOffscreen>true</drawOffscreen>
        <seeThroughFog>true</seeThroughFog>
        <graphicData>
            <texPath>Things/Projectile/GOW_TorquebowShot</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1</drawSize>
        </graphicData>
        <projectile>
         <damageDef>Bomb</damageDef>
	     <damageAmountBase>20</damageAmountBase>
		 <explosionRadius>1.9</explosionRadius >
         <speed>30</speed>
        </projectile>
    <comps>
    </comps>
    <modExtensions>
      <li Class="MstToyBox.ModExt_Mst_BezierProjectile">
        <drawStartDelay>1</drawStartDelay>
        <trailFleckDef>GW_Locust_TorqueFleck</trailFleckDef>
        <trailThickness>0.5</trailThickness>
        <probeStep>0.05</probeStep> 
        <useCubieCurve>true</useCubieCurve>
        <enableRandomSide>true</enableRandomSide>
        <randomSideChance>0</randomSideChance>
        <randOffsetRange>
          <min>0</min>
          <max>0</max>
        </randOffsetRange>
        <P1Offset>0</P1Offset>
        <P1Side>0</P1Side>
        <P2Offset>0</P2Offset>
        <P2Side>0</P2Side>
      </li>
        </modExtensions>
  </ThingDef>

</Defs>