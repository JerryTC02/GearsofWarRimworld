<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <ThingDef ParentName="BenchBase">
    <defName>GOW_Locust_SimpleResearchBench</defName>
    <label>Locust Research Station</label>
    <description>An intricate bench with Locust runic scriptures and crude research tools.\n\nRequired for most Locust researchs, also functions as a normal research bench</description>
    <thingClass>Building_ResearchBench</thingClass>
    <size>(5,2)</size>
    <costList>
      <Steel>125</Steel>
	  <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/RWlocust/Buildings/GOW_LocustResearchtable/Locust_LookupTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>575</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.2</Flammability>
      <ResearchSpeedFactor>1.05</ResearchSpeedFactor>
    </statBases>
    <researchPrerequisites>
      <li>GOW_Locustbasic</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_DrawLinesToBookcasesInRoom</li>
    </placeWorkers>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <building>
      <paintable>false</paintable>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.95</workTableNotInRoomRoleFactor>
    </building>
    <comps Inherit="False">
      <li Class="CompProperties_ReportWorkSpeed">
        <workSpeedStat>ResearchSpeedFactor</workSpeedStat>
      </li>
	  <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
  </ThingDef>

</Defs>
