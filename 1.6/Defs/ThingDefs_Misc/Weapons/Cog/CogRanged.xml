  <ThingDef ParentName="RWCogBaseHumanMakeableGun">
    <defName>Gun_GOW_Gnasher</defName>
    <label>Gnasher Shotgun</label>
    <description>A short-barrel lever-action shotgun commonly deployed by the COG. Relatively simple and easy to aim, making it exceptionally useful for close quarters combat.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWcog/Weapons/GOW_GnasherShotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Cogmillitary</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>4000</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>25500</WorkToMake>
      <Mass>5</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.60</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.10</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <costList>
