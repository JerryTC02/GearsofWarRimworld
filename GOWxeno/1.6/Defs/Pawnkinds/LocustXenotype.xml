  </GeneDef>

  <GeneDef ParentName="LocustGenes">
    <defName>GOW_LocustDrone</defName>
    <label>Drone Caste</label>
    <description>Drones are the rank and file of the Locust Horde, handling the majority of its tasks and defense. All locust possess a thick hide that can shrug off and dampen lesser blows.</description>
    <iconPath>UI/Icons/Xenotypes/GOW_Drone</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
    <biostatMet>-1</biostatMet>
    <biostatCpx>5</biostatCpx>
	<forcedHeadTypes>
      <li>Male_Locust_Drone</li>
    </forcedHeadTypes>
	<exclusionTags>
      <li>Fur</li>
    </exclusionTags>
    <statFactors>
      <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.3</CertaintyLossFactor>
	  <SM_BodySizeMultiplier>1.10</SM_BodySizeMultiplier>
	  <IncomingDamageFactor>0.90</IncomingDamageFactor>
    </statFactors>
	<damageFactors>
      <Flame>1.20</Flame>
    </damageFactors>
    <statOffsets>
	  <PainShockThreshold>0.10</PainShockThreshold>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
    </statOffsets>
    <skinIsHairColor>false</skinIsHairColor>
	<modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <bodyPaths>
          <Body_Female>Things/Pawn/Humanlike/Bodies/Naked_Drone_Female</Body_Female>
          <Body_Male>Things/Pawn/Humanlike/Bodies/Naked_Drone_Male</Body_Male>
		  <Body_Fat>Things/Pawn/Humanlike/Bodies/Naked_Boomer_Fat</Body_Fat>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="LocustGenes">
    <defName>GOW_LocustBoomer</defName>
    <label>Boomer Caste</label>
    <description>Boomers are the dumb muscle of the Locust Horde, dealing with heavy lifting and menial tasks. Boomer hides are thicker then the standard Locust hide.</description>
    <iconPath>UI/Icons/Xenotypes/GOW_Boomer</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
	<disabledWorkTags>
      <li>Intellectual</li>
    </disabledWorkTags>
    <biostatMet>-1</biostatMet>
    <biostatCpx>5</biostatCpx>
	<forcedHeadTypes>
      <li>Male_Locust_Boomer</li>
    </forcedHeadTypes>
	<exclusionTags>
      <li>Fur</li>
    </exclusionTags>
    <statFactors>
      <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.15</CertaintyLossFactor>
	  <SM_BodySizeMultiplier>1.35</SM_BodySizeMultiplier>
	  <IncomingDamageFactor>0.80</IncomingDamageFactor>
	  <StaggerDurationFactor>0.9</StaggerDurationFactor>
    </statFactors>
    <damageFactors>
      <Flame>1.10</Flame>
    </damageFactors>
    <statOffsets>
	  <PainShockThreshold>0.25</PainShockThreshold>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
    </statOffsets>
    <skinIsHairColor>false</skinIsHairColor>
	<modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <bodyPaths>
          <Body_Female>Things/Pawn/Humanlike/Bodies/Naked_Drone_Female</Body_Female>
          <Body_Male>Things/Pawn/Humanlike/Bodies/Naked_Drone_Male</Body_Male>
		  <Body_Fat>Things/Pawn/Humanlike/Bodies/Naked_Boomer_Fat</Body_Fat>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="LocustGenes">
    <defName>GOW_LocustKantus</defName>
    <label>Kantus Caste</label>
    <description>Kantus are the religious leaders of the Locust Horde and some theories suggest they are true natives of the Hollow unlike the Locust themselves. All locust possess a thick hide that can shrug off and dampen lesser blows.</description>
    <iconPath>UI/Icons/Xenotypes/GOW_Kantus</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
    <biostatMet>1</biostatMet>
    <biostatCpx>5</biostatCpx>
	<forcedHeadTypes>
      <li>Male_Locust_Kantus</li>
    </forcedHeadTypes>
	<exclusionTags>
      <li>Fur</li>
    </exclusionTags>
	<abilities>
      <li>Locust_AnimalWarcall</li>
	  <li>Locust_HealingWarcall</li>
	  <li>Locust_StunningWarcall</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>Locust_AnimalWarcall</AbilityDef>
    </descriptionHyperlinks>
    <statFactors>
      <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.3</CertaintyLossFactor>
	  <SM_BodySizeMultiplier>1.20</SM_BodySizeMultiplier>
	  <IncomingDamageFactor>0.85</IncomingDamageFactor>
	  <InjuryHealingFactor>1.15</InjuryHealingFactor>
	  <ImmunityGainSpeed>1.05</ImmunityGainSpeed>
	  <LifespanFactor>1.25</LifespanFactor>
    </statFactors>
	<damageFactors>
      <Flame>1.20</Flame>
    </damageFactors>
    <statOffsets>
	  <PainShockThreshold>0.20</PainShockThreshold>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
    </statOffsets>
    <skinIsHairColor>false</skinIsHairColor>
	<modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <bodyPaths>
          <Body_Female>Things/Pawn/Humanlike/Bodies/Naked_Drone_Female</Body_Female>
          <Body_Male>Things/Pawn/Humanlike/Bodies/Naked_Drone_Male</Body_Male>
		  <Body_Fat>Things/Pawn/Humanlike/Bodies/Naked_Boomer_Fat</Body_Fat>
        </bodyPaths>
      </li>
    </modExtensions>
  </GeneDef>
  
  <GeneDef ParentName="LocustGenes">
    <defName>GOW_LocustBerserker</defName>
    <label>Berserker Caste</label>
    <description>Berserkers are the giant heavily armored females of the Locust, incapable of most higher thoughts except rage and hatred.</description>
    <iconPath>UI/Icons/Xenotypes/GOW_Berserker</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
	<forcedTraits>
      <li>
        <def>Psychopath</def>
      </li>
    </forcedTraits>
    <disabledWorkTags>
      <li>Social</li>
	  <li>Commoner</li>
    </disabledWorkTags>
    <biostatMet>5</biostatMet>
    <biostatCpx>5</biostatCpx>
	<forcedHeadTypes>
      <li>Female_Locust_Berserker</li>
    </forcedHeadTypes>
	<exclusionTags>
      <li>Fur</li>
    </exclusionTags>
	<tattoosVisible>false</tattoosVisible>
    <statFactors>
      <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.02</CertaintyLossFactor>
	  <SM_BodySizeMultiplier>3.5</SM_BodySizeMultiplier>
	  <IncomingDamageFactor>0.60</IncomingDamageFactor>
	  <ImmunityGainSpeed>1.25</ImmunityGainSpeed>
	  <InjuryHealingFactor>2</InjuryHealingFactor>
	  <Fertility>3</Fertility>
	  <StaggerDurationFactor>0.25</StaggerDurationFactor>
    </statFactors>
	<painFactor>0.25</painFactor>
	<damageFactors>
      <Flame>1.50</Flame>
    </damageFactors>
    <statOffsets>
      <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.70</ArmorRating_Blunt>
	  <ComfyTemperatureMax>20</ComfyTemperatureMax>
	  <ComfyTemperatureMin>-40</ComfyTemperatureMin>
    </statOffsets>
    <skinIsHairColor>false</skinIsHairColor>
	<modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <bodyPaths>
          <Body_Female>Things/Pawn/Humanlike/Bodies/Berserker_Female</Body_Female>
        </bodyPaths>
		<headDrawData>
          <dataSouth>
            <offset>(0.0, 0, -0.25)</offset>
          </dataSouth>
		  <dataNorth>
            <offset>(0.0, -1, -0.25)</offset>
          </dataNorth>
          <dataEast>
            <offset>(0.0, 0, -0.27)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.0, 0, -0.27)</offset>
          </dataWest>
        </headDrawData>
		<bodyMaterial>
          <shader>CutoutComplex</shader>
          <overrideDesiccated>true</overrideDesiccated>
        </bodyMaterial>
		<apparelRestrictions>
          <absolutelyNothing>true</absolutelyNothing>
        </apparelRestrictions>
		<babyStartAge>7</babyStartAge>
		<pregnancyQuality>0.75</pregnancyQuality>
		<pregnancySpeedMultiplier>3</pregnancySpeedMultiplier>
      </li>
	  <li Class="BirthOutcome.GeneExtension_BirthXenotype">
            <chanceToApply>1.0</chanceToApply>
            <chance>0.02</chance>                
            <xenotypeDefA>Locust_Berserker</xenotypeDefA>
            <isFixGenderA>True</isFixGenderA>
            <fixedGenderA>Female</fixedGenderA>
            <xenotypeDefB></xenotypeDefB>
            <xenotypeSetB>
                <li>
                    <xenotypeDef>Locust_Drone</xenotypeDef>
                    <weight>0.65</weight>
                </li>
                <li>
                    <xenotypeDef>Locust_Boomer</xenotypeDef>
                    <weight>0.25</weight>
                </li>
                <li>
                    <xenotypeDef>Locust_Kantus</xenotypeDef>
                    <weight>0.10</weight>
                </li>
            </xenotypeSetB>
            <isFixGenderB>True</isFixGenderB>
            <fixedGenderB>Male</fixedGenderB>
     </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="LocustGenes">
    <defName>GOW_LocustMental</defName>
    <label>Locust Mentality</label>
    <labelShortAdj>Locust Mentality</labelShortAdj>
    <description>Locust are uniquely xenophobic, stemming from Queen Myrrahs extreme Anti-COG and Anti-Human propaganda. Locust also possess an incredibly low level of empathy, and tend not to care about things such as death or cannibalism.</description>
    <iconPath>UI/Icons/LocustGene</iconPath>
    <missingGeneRomanceChanceFactor>0.1</missingGeneRomanceChanceFactor>
    <displayOrderInCategory>4</displayOrderInCategory>
    <biostatMet>0</biostatMet>
	<biostatCpx>5</biostatCpx>
  </GeneDef>
  
