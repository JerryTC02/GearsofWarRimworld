<Defs>

  <ThingDef ParentName="RWCogArmorMachineableBase">
    <defName>Apparel_GOW_Cogsoldier</defName>
    <label>COG Trooper Armor</label>
    <description>The standard-issue armor in the COG army, Trooper armor is designed to provide ample protection against small arms fire without impeding mobility during combat. While many modifications have been made to it over the years, the Troopers basic design concepts have never quite been fully retired.</description>
    <techLevel>Industrial</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>GOW_Cogmillitary</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
	  <displayPriority>1</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/RWcog/Apparel/GOW_CogSoldier/GOW_CogSoldier_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>32500</WorkToMake>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>12</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.85</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.40</ArmorRating_Blunt>
      <ArmorRating_Heat>0.35</ArmorRating_Heat>
      <Insulation_Cold>15</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.10</MoveSpeed>
	  <PainShockThreshold>0.05</PainShockThreshold>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <costList>
	  <Steel>140</Steel>
	  <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
	  <tags>
        <li>COGGear</li>
      </tags>
      <wornGraphicPath>Things/RWcog/Apparel/GOW_CogSoldier/GOW_CogSoldier</wornGraphicPath>
      <layers>
        <li>Middle</li>
		<li>Shell</li>
      </layers>
    </apparel>
	<modExtensions>
     <li Class="taranchuk_apparelgraphics.ApparelExtension">
      <hideBody>True</hideBody>
      <femaleBody>Female</femaleBody>
      <maleBody>Male</maleBody>
     </li>
    </modExtensions>
  </ThingDef>
  
