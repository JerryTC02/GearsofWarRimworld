  <ThoughtDef>
    <defName>GOW_LocustMentalThought</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>CVNGeneUtils.ThoughtWorker_Gene</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>Locust</label>
		<description>Locust swarm together, locust work together, locust win together.</description>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
	  	<li>
			<label>Not Locust</label>
			<description>Will kill this one, someday.</description>
			<baseOpinionOffset>-50</baseOpinionOffset>
		</li>
    </stages>
    <modExtensions>
     <li Class="CVNGeneUtils.ThoughtExtension_GeneOpinion">
      <geneDefs>
      <li>GOW_LocustMental</li>
      </geneDefs>
      <state>0</state>
	  <isGiveThoughtToPawnNotMatching>True</isGiveThoughtToPawnNotMatching>
	  <stateNotMatch>1</stateNotMatch>
     </li>
    </modExtensions>
  </ThoughtDef>

  <XenotypeDef>
    <defName>Locust_Drone</defName>
    <label>Drone</label>
    <description>Drones, often referred to as Grubs, are the foot soldiers of the Locust Horde. Completely loyal to their Queen and aggressive to outsiders, Drones are willing to toss their lives away to kill a single foe.</description>
    <descriptionShort>Drones are the foot soldiers of the Locust Horde, loyal and highly aggressive to outsiders.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/GOW_Drone</iconPath>
    <inheritable>true</inheritable>
    <chanceToUseNameMaker>1</chanceToUseNameMaker>
    <genes>
	  <li MayRequire="RedMattis.BetterPrerequisites">Body_MaleOnly</li>
	  <li>GOW_LocustDrone</li>
	  <li>GOW_LocustMental</li>
	  <li>Beard_NoBeardOnly</li>
	  <li>Hair_BaldOnly</li>
	  <li>Aggression_Aggressive</li>
	  <li>AptitudeStrong_Mining</li>
	  <li>AptitudeStrong_Melee</li>
	  <li>AptitudePoor_Intellectual</li>
	  <li>AptitudePoor_Social</li>
	  <li>AptitudePoor_Medicine</li>
	  <li>DarkVision</li>
	  <li>CaveDweller</li>
	  <li>Mood_Optimist</li>
	  <li>Body_Standard</li>
	  <li>Skin_Locust_pale</li>
	  <li>Skin_Locust_palee</li>
	  <li>Skin_Locust_paleee</li>
	  <li>Skin_Locust_paleeee</li>
    </genes>
  </XenotypeDef>
  
  <XenotypeDef>
    <defName>Locust_Boomer</defName>
    <label>Boomer</label>
    <description>Boomers are a large, brutish, and vastly less intelligent then the standard Drone. being Incredibly bulky but dimwitted leads to them mostly dealing with more menial tasks such as butchery, hauling, and mining.</description>
    <descriptionShort>Boomers are a large, brutish, and vastly less intelligent caste of Locust.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/GOW_Boomer</iconPath>
    <inheritable>true</inheritable>
