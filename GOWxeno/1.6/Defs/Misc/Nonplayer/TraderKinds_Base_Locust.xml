<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TraderKindDef>
    <defName>Base_Locust_Standard</defName>
    <stockGenerators>
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>750~1750</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>25~65</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>500~1000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WoodLog</thingDef>
        <countRange>200~500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Plasteel</thingDef>
        <countRange>50~125</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Uranium</thingDef>
        <countRange>10~50</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>100~300</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>Leather_Patch</thingDef>
        <countRange>450~750</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Gold</thingDef>
        <countRange>50~100</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Neutroamine</thingDef>
        <countRange>50~100</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>200~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>15~35</countRange>
      </li>
      <li Class="StockGenerator_ReinforcedBarrels">
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>MortarShell</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>25~45</countRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Shell_Deadlife</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <thingDefCountRange>1~2</thingDefCountRange>
        <totalPriceRange>100~300</totalPriceRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Leather_Dread</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>ResourcesRaw</categoryDef>
        <thingDefCountRange>1~4</thingDefCountRange>
        <totalPriceRange>150~500</totalPriceRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>225~500</totalPriceRange>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodMeals</categoryDef>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>10~25</countRange>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>Kibble</li>
          <li>Pemmican</li>
        </thingDefs>
      </li>
      <!-- Drugs -->
      <li Class="StockGenerator_Category">
        <categoryDef>Drugs</categoryDef>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>500~1500</totalPriceRange>
      </li>
      <!-- Weapons -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustRanged</tradeTag>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>WeaponRanged</tradeTag>
        <countRange>1~3</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustMelee</tradeTag>
        <countRange>1~3</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>WeaponsMelee</tradeTag>
        <countRange>1~2</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>CogRanged</tradeTag>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>CogMelee</tradeTag>
        <countRange>1~2</countRange>
      </li>
      <!-- Apparel -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustArmor</tradeTag>
        <countRange>2~5</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>Armor</tradeTag>
        <countRange>1~3</countRange>
      </li>
      <!-- Implants -->
      <li Class="StockGenerator_Tag">
        <tradeTag>TechHediff</tradeTag>
        <thingDefCountRange>2~4</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <!-- Buildings -->
      <li Class="StockGenerator_Category">
        <categoryDef>BuildingsFurniture</categoryDef>
        <thingDefCountRange>3~4</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <!-- Exotic -->
      <li Class="StockGenerator_Tag">
        <tradeTag>Artifact</tradeTag>
        <thingDefCountRange>1~4</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>1~4</thingDefCountRange>
        <countRange>1~2</countRange>
        <excludedThingDefs>
          <li>Luciferium</li> <!-- already handled by drugs -->
          <li>ComponentSpacer</li> <!-- already handled by single def -->
        </excludedThingDefs>
        <customCountRanges>
          <MedicineUltratech>1~3</MedicineUltratech>
          <Hyperweave>25~50</Hyperweave>
        </customCountRanges>
      </li>
      <!-- Genepacks -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>Genepack</thingDef>
        <countRange>0~4</countRange>
      </li>
      <!-- Slaves -->
      <li Class="StockGenerator_Slaves">
        <respectPopulationIntent>false</respectPopulationIntent>
        <countRange>10~15</countRange>
		<slaveKindDef>GOW_Locust_POW</slaveKindDef>
      </li>
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
          <li>AnimalFarm</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>2~4</kindCountRange>
        <countRange>3~8</countRange>
        <createMatingPair>
          <li>AnimalFarm</li>
        </createMatingPair>
      </li>
      <!-- Archite capsule2 -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>ArchiteCapsule</thingDef>
        <countRange>-1~1</countRange> <!-- 50% chance for 1~2 -->
      </li>
      <!-- Deathrest capacity serum -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>DeathrestCapacitySerum</thingDef>
        <countRange>0~1</countRange>
      </li>
      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ImplantEmpireCommon</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ImplantEmpireRoyal</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>UtilitySpecial</tag></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Shell_Deadlife</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>VoidSculpture</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Shard</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Bioferrite</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>RevenantSpine</thingDef></li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
