  <ThingDef ParentName="RWCogArmorMachineableBase">
     <defName>Apparel_GOW_Cogtag</defName>
     <label>COG Dogtags</label>
     <description>Steel plates made in the shape of a cog stamped with the name of the soldier carrying it, used as a way to identify Gears who fell in battle.\n\n"Property of the Coalition of Ordered Governments" is stamped on another part of the tag.</description>
     <techLevel>Industrial</techLevel>
     <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>GOW_Cogmillitary</researchPrerequisite>
       <skillRequirements>
         <Crafting>5</Crafting>
       </skillRequirements>
	  <displayPriority>100</displayPriority>
     </recipeMaker>
     <graphicData>
       <texPath>Things/RWcog/Apparel/GOW_Cogtag/COGTag_item</texPath>
       <graphicClass>Graphic_Single</graphicClass>
	   <drawSize>0.8</drawSize>
     </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <statBases>
      <WorkToMake>1000</WorkToMake>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.02</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.01</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Insulation_Cold>0</Insulation_Cold>
      <Insulation_Heat>0</Insulation_Heat>
      <EquipDelay>0.2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
	  <MentalBreakThreshold>-0.02</MentalBreakThreshold>
	  <PainShockThreshold>0.02</PainShockThreshold>
	  <ShootingAccuracyPawn>0.01</ShootingAccuracyPawn>
    </equippedStatOffsets>
	<thingCategories Inherit="False">
      <li>GOW_Category_COG_Headgear</li>
    </thingCategories>
    <costList>
	  <Steel>2</Steel>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Neck</li>
      </bodyPartGroups>
	  <wornGraphicPath>Things/RWcog/Apparel/GOW_Cogtag/COGTag</wornGraphicPath>
	  <countsAsClothingForNudity>false</countsAsClothingForNudity>
	  <tags>
        <li>COGGearTag</li>
      </tags>
      <layers>
        <li>GOW_Dogtag</li>
      </layers>
	  <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
  </ThingDef>
  
  <ThingDef ParentName="RWCogArmorMachineableBase">
