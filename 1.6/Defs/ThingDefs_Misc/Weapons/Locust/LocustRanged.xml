<?xml version="1.0" encoding="utf-8" ?>

<Defs>
 
  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_Hammerburst</defName>
    <label>Hammerburst Assault Rifle</label>
    <description>The standard-issue Locust assault rifle early in the Locust War, the Hammerburst is known for its deadly 6 round burst fire. Despite its effectiveness in medium range combat, the hammerburst is overall disliked due to its lack of CQC options, alongside not quite being accurate enough for long range engagement.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_HammerburstAssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustdrones</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>2000</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>47500</WorkToMake>
      <Mass>5</Mass>
      <AccuracyTouch>0.40</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.25</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>9</ComponentIndustrial>
    </costList>
    <weaponTags>
	 <li>LocustHammerburst</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Hammerburst</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>25.9</range>
        <burstShotCount>6</burstShotCount>
        <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
        <soundCast>Shot_GOW_MK2Hammerburst</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Hammerburst</defName>
    <label>hammerburst bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>70</speed>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_HammerburstTwo</defName>
    <label>Hammerburst Assault Rifle II</label>
    <description>Based on the common Hammerburst, the MK2 variant has been improved with an extended barrel and more refined ironsights to provide higher accuracy at long ranges. Much like its predecessor, it still lacks good defense against CQC.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_HammerburstAssaultRifleTwo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.90</drawSize>
    </graphicData>
    <equippedAngleOffset>40</equippedAngleOffset>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustdrones</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>2001</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>52500</WorkToMake>
      <Mass>5.5</Mass>
      <AccuracyTouch>0.45</AccuracyTouch>
      <AccuracyShort>0.63</AccuracyShort>
      <AccuracyMedium>0.72</AccuracyMedium>
      <AccuracyLong>0.38</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>110</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <weaponTags>
	 <li>LocustHammerburstTwo</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Hammerbursttwo</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>27.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_GOW_MK2Hammerburst</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Hammerbursttwo</defName>
    <label>hammerburst II bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>11</damageAmountBase>
      <speed>70</speed>
    </projectile>
  </ThingDef>

</Defs>