<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TraderKindDef>
    <defName>Caravan_Locust_Logistics</defName>
    <label>Supply Caravan</label>
	<requestable>true</requestable>
    <stockGenerators>
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>500~750</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>10~25</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>10~15</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>15~25</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>400~500</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>Uranium</thingDef>
        <countRange>-25~25</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>WoodLog</thingDef>
        <countRange>200~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Plasteel</thingDef>
        <countRange>75~125</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Leather_Patch</thingDef>
        <countRange>250~500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>200~300</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Neutroamine</thingDef>
        <countRange>25~100</countRange>
      </li>
      <li Class="StockGenerator_ReinforcedBarrels">
        <countRange>1~2</countRange>
      </li>
	  <li Class="StockGenerator_Tag">
        <tradeTag>MortarShell</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>20~40</countRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Shell_Deadlife</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <thingDefCountRange>3~3</thingDefCountRange>
        <totalPriceRange>300~500</totalPriceRange>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Leather_Dread</li>
        </excludedThingDefs>
      </li>
      <!-- Drugs -->
      <li Class="StockGenerator_Category">
        <categoryDef>Drugs</categoryDef>
      </li>
      <!-- Books -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Schematic</thingDef>
        <countRange>1~2</countRange>
      </li>
      <!-- Weapons -->
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>WeaponRanged</tradeTag>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>WeaponsMelee</categoryDef>
        <thingDefCountRange>3~4</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustRanged</tradeTag>
        <countRange>1~3</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustMelee</tradeTag>
        <countRange>1~3</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>CogRanged</tradeTag>
        <countRange>-1~2</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>CogMelee</tradeTag>
        <countRange>-1~2</countRange>
      </li>
      <!-- Apparel -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustArmor</tradeTag>
        <countRange>2~4</countRange>
      </li>
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>Armor</tradeTag>
        <countRange>1~3</countRange>
      </li>
      <!-- Buildings -->
	  <!-- Genepacks -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>Genepack</thingDef>
        <countRange>1~1</countRange>
      </li>
      <!-- Slaves -->
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <maxWildness>0.70</maxWildness>
        <tradeTagsSell>
          <li>AnimalFarm</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>1</kindCountRange>
        <countRange>2~3</countRange>
        <createMatingPair>
          <li>AnimalFarm</li>
        </createMatingPair>
      </li>
      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <!--======================================================================================-->

  <TraderKindDef>
    <defName>Caravan_Locust_Slaver</defName>
    <label>Processing Caravan</label>
    <requestable>true</requestable>
    <category>Slaver</category>
    <stockGenerators>
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>1000~1500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>1~3</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>3~5</countRange>
      </li>
	  <li Class="StockGenerator_SingleDef">
        <thingDef>Leather_Human</thingDef>
        <countRange>25~150</countRange>
      </li>
	 <li Class="StockGenerator_SingleDef">
        <thingDef>Meat_Human</thingDef>
        <countRange>50~200</countRange>
      </li>
      <!-- Drugs -->
      <li Class="StockGenerator_Category">
        <categoryDef>Drugs</categoryDef>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>500~1000</totalPriceRange>
      </li>
      <!-- Weapons -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustRanged</tradeTag>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>LocustMelee</tradeTag>
        <countRange>1~2</countRange>
      </li>
      <!-- Apparel -->
	  <li Class="StockGenerator_MarketValue">
        <tradeTag>BasicClothing</tradeTag>
        <countRange>3~6</countRange>
      </li>
      <!-- Genepacks -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>Genepack</thingDef>
        <countRange>1~1</countRange>
      </li>
      <!-- Slaves -->
      <li Class="StockGenerator_Slaves">
        <countRange>9~12</countRange>
		<slaveKindDef>GOW_Locust_POW</slaveKindDef>
      </li>
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
          <li>AnimalFighter</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>1~2</kindCountRange>
        <countRange>1~3</countRange>
      </li>      
      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

</Defs>
