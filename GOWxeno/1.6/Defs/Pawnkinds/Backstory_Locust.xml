<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <BackstoryDef>
    <defName>GOW_LocustLarva</defName>
    <identifier>Locust Larva</identifier>
    <slot>Childhood</slot> 
    <title>Larva</title>
    <titleShort>Larva</titleShort>
    <description>[PAWN_nameDef] was born in a dark cave somewhere in the Hollow.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustLarva</li>
	  <li>LocustBerserker</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Drone</defName>
    <identifier>Drone</identifier>
    <slot>Adulthood</slot> 
    <skillGains>
      <Mining>1</Mining>
	  <Construction>1</Construction>
      <Plants>1</Plants>
	  <Social>-2</Social>
    </skillGains>
    <title>Drone</title>
    <titleShort>Drone</titleShort>
    <description>[PAWN_nameDef] grew into a simple Drone, [PAWN_pronoun] is the backbone of the Nexus, and a loyal servant of the Queen.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustDrone</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Cyclops</defName>
    <identifier>Cyclops</identifier>
    <slot>Adulthood</slot>
    <skillGains>
      <Shooting>2</Shooting>
      <Melee>3</Melee>
	  <Social>-3</Social>
    </skillGains>
    <title>Cyclops</title>
    <titleShort>Cyclops</titleShort>
    <description>[PAWN_nameDef] has survived many battles on the surface, and developed a tendency to loot the equipment of fallen enemy soldiers.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustCyclops</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Beastrider</defName>
    <identifier>Beastrider</identifier>
    <slot>Adulthood</slot>
    <skillGains>
      <Animals>3</Animals>
      <Shooting>1</Shooting>
    </skillGains>	
    <title>Beastrider</title>
    <titleShort>Beastrider</titleShort>
    <description>[PAWN_nameDef] has a talent for taming the many beasts of the hollow, [PAWN_pronoun] ensures the Horde will always have an ample supply of warbeasts.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
	  <li>LocustBeastrider</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Bolter</defName>
    <identifier>Bolter</identifier>
    <slot>Adulthood</slot> 
    <title>Bolter</title>
    <titleShort>Bolter</titleShort>
    <description>[PAWN_nameDef] has been specially trained in hit and run tactics, skilled in darting between cover and harasssing enemy troops.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
	  <li>LocustBolter</li>
    </spawnCategories>
	<skillGains>
      <Shooting>3</Shooting>
	  <Social>-1</Social>
    </skillGains>
	<forcedTraits>
      <SpeedOffset>2</SpeedOffset>
    </forcedTraits>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <TraitDef>
    <defName>GOW_Stock</defName>
    <commonality>0.000000001</commonality>
    <degreeDatas>
      <li>
        <label>Size Mutation</label>
        <description>{PAWN_nameDef} has a size mutation which makes them more durable.</description>
        <statFactors>
          <SM_BodySizeMultiplier>1.25</SM_BodySizeMultiplier>
        </statFactors>
      </li>
    </degreeDatas>
    <exclusionTags>
	  <li>Large</li>
      <li>Gigantism</li>
      <li>Small</li>
      <li>Dwarfism</li>
    </exclusionTags>
  </TraitDef>
  
  <BackstoryDef>
    <defName>GOW_Theron</defName>
    <identifier>Theron Guard</identifier>
    <slot>Adulthood</slot>
	<workDisables>
      <li>ManualDumb</li>
    </workDisables>
    <skillGains>
      <Shooting>4</Shooting>
      <Melee>3</Melee>
	  <Social>-2</Social>
    </skillGains>
	<forcedTraits>
      <GOW_Stock>0</GOW_Stock>
    </forcedTraits>
    <title>Theron Guard</title>
    <titleShort>Theron</titleShort>
    <description>[PAWN_nameDef] grew larger than most drones, fought harder than other drones, and has shown absolute and utter devotion to the Queen. For these reasons [PAWN_pronoun] has been granted the honor of serving in the Queens personal army, the Theron Guard.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustTheron</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Boomer</defName>
    <identifier>Boomer</identifier>
    <slot>Adulthood</slot> 
    <workDisables>
      <li>Crafting</li>
	  <li>Cooking</li>
    </workDisables>
    <title>Boomer</title>
    <titleShort>Boomer</titleShort>
    <description>[PAWN_nameDef] grew into a boomer, quite strong but not very intelligent. [PAWN_pronoun] is good at breaking things and not much else.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustBoomer</li>
    </spawnCategories>
    <skillGains>
      <Shooting>2</Shooting>
      <Melee>2</Melee>
    </skillGains>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Butcher</defName>
    <identifier>Butcher</identifier>
    <slot>Adulthood</slot> 
    <title>Butcher</title>
    <titleShort>Boomer</titleShort>
    <description>[PAWN_nameDef] is a boomer born with slightly higher intelligence then other boomers, and a talent for "cooking".</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustButcher</li>
    </spawnCategories>
    <skillGains>
      <Melee>5</Melee>
      <Cooking>2</Cooking>
	  <Animals>1</Animals>
    </skillGains>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_KantusAcolyte</defName>
    <identifier>Kantus Acolyte</identifier>
    <slot>Adulthood</slot> 
    <skillGains>
	  <Melee>2</Melee>
	  <Social>2</Social>
	  <Medicine>1</Medicine>
    </skillGains>
    <title>Kantus Acolyte</title>
    <titleShort>Acolyte</titleShort>
    <description>[PAWN_nameDef] grew into a Kantus and was inducted into the ranks of the Kantus Priesthood to begin training, they spent their days memorizing the various scripture of the Trinity and sparring with staves.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustKantusAcolyte</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Kantus</defName>
    <identifier>Kantus Priest</identifier>
    <slot>Adulthood</slot>
	<workDisables>
      <li>ManualDumb</li>
    </workDisables>
    <skillGains>
	  <Melee>3</Melee>
      <Animals>1</Animals>
	  <Medicine>2</Medicine>
	  <Social>4</Social>
    </skillGains>
    <title>Kantus</title>
    <titleShort>Kantus</titleShort>
    <description>[PAWN_nameDef] finished training as an Acolyte and now serves as a full Priest of the Trinity of Worms, [PAWN_pronoun] is a leader in every sense of the word, enforcing the Queens law without question.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustKantus</li>
    </spawnCategories>
    <shuffleable>True</shuffleable>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>GOW_Berserker</defName>
    <identifier>Beserker</identifier>
    <slot>Adulthood</slot> 
    <skillGains>
	  <Melee>7</Melee>
    </skillGains>
    <title>Berserker</title>
    <titleShort>Berserker</titleShort>
    <description>[PAWN_nameDef] was unfortunate enough to be born a Berserker, and has spent the majority of her life fighting or being abused.</description>
    <requiredWorkTags>None</requiredWorkTags>
    <spawnCategories>
      <li>LocustBerserker</li>
    </spawnCategories>
    <shuffleable>true</shuffleable>
  </BackstoryDef>
    
</Defs>