<Defs>

   <ResearchProjectDef>
	 <defName>GOW_Cogbasic</defName>
	 <label>Octus Canon</label>
	 <techLevel>Industrial</techLevel>
	 <description>The founding beliefs of the Coalition of Order Governments, understanding these is essential to understanding every aspect of the C.O.G from millitary to civillian life.</description>
	 <baseCost>750</baseCost>
	 <tab>GOW_Cog</tab>
     <prerequisites>
	  <li>Machining</li>
	 </prerequisites>
    <researchViewX>0.00</researchViewX>
    <researchViewY>2.00</researchViewY>
   </ResearchProjectDef>
   
   <ResearchProjectDef>
	 <defName>GOW_Cogmillitary</defName>
	 <label>Enlistment Propaganda</label>
	 <techLevel>Industrial</techLevel>
	 <description>To fight for your country is not just considered honorable, but is expected of every citizen under the Coalition. This has allowed the C.O.G millitary to have unmatched manpower and millitary budget for the production of high quality equipment.</description>
	 <baseCost>1000</baseCost>
	 <tab>GOW_Cog</tab>
     <prerequisites>
	  <li>GOW_Cogbasic</li>
	  <li>FlakArmor</li>
	  <li>GasOperation</li>
	 </prerequisites>
	 <requiredResearchBuilding>GOW_COG_SimpleResearchBench</requiredResearchBuilding>
    <researchViewX>1.00</researchViewX>
    <researchViewY>1.00</researchViewY>
   </ResearchProjectDef>
      
   <ResearchProjectDef>
	 <defName>GOW_CogWeapons</defName>
	 <label>Emergence Day</label>
	 <techLevel>Industrial</techLevel>
	 <description>Soon after Emergence Day, martial law was enacted enmasse among the Coalition and all resources were put to researching new ways to combat the Locust Threat, resulting in many inventions such as the Lancer MK2.</description>
	 <baseCost>1250</baseCost>
	 <tab>GOW_Cog</tab>
     <prerequisites>
	  <li>GOW_Cogmillitary</li>
	  <li>PrecisionRifling</li>
	 </prerequisites>
	 <requiredResearchBuilding>GOW_COG_SimpleResearchBench</requiredResearchBuilding>
    <researchViewX>2.00</researchViewX>
    <researchViewY>1.00</researchViewY>
   </ResearchProjectDef>
   
