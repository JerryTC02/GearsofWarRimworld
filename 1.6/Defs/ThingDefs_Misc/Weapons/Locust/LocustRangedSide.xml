<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <ThingDef ParentName="BaseLocustMakeableGrenade">
    <defName>Weapon_GOW_LocustFrag</defName>
    <label>Locust Bolo-Frag</label>
    <description>A small explosive tied to the end of a long chain, capable of reaching further distances then standard grenades. This Bolo is of locust manufacture.</description>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustdrones</researchPrerequisite>
	  <displayPriority>900</displayPriority>
    </recipeMaker>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_FragGrenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Industrial</techLevel>
    <statBases>
      <Mass>1.5</Mass>
      <RangedWeapon_Cooldown>2.66</RangedWeapon_Cooldown>
      <WorkToMake>20000</WorkToMake>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <Chemfuel>85</Chemfuel>
    </costList>
    <weaponTags>
      <li>LocustGrenadeDestructive</li>
    </weaponTags>
    <smeltable>true</smeltable>
    <verbs>
      <li>
        <label>throw bolo-frag</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>21.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>2.1</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>Shot_GOW_Bolo</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>Proj_GOW_LocustGrenadeFrag</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.66</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>Proj_GOW_LocustGrenadeFrag</defName>
	<label>bolo-frag</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_FragGrenade_Thrown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>1.9</explosionRadius >
      <damageDef>Bomb</damageDef>
      <explosionDelay>75</explosionDelay>
	  <spinRate>2</spinRate>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_Boltok</defName>
    <label>Boltok Pistol</label>
    <description>The Boltok is a high-caliber, double-action revolver with a 6-round capacity, a side swing chamber, and an enclosed hammer. It is heavy, slow to fire, and slow to reload, but does devastating damage on impact</description>
    <techLevel>Industrial</techLevel>
	<graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_BoltokPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustbasic</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>1001</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>7250</WorkToMake>
      <Mass>2.65</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1.9</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
	<weaponTags>
	 <li>Locustsidearm</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Boltok</defaultProjectile>
        <warmupTime>0.2</warmupTime>
        <range>30.9</range>
        <soundCast>Shot_GOW_Boltok</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.85</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Boltok</defName>
    <label>boltok round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>16</damageAmountBase>
	  <stoppingPower>1.5</stoppingPower>
      <speed>50</speed>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="RWLocustBaseHumanMakeableGun">
    <defName>Gun_GOW_Gorgon</defName>
    <label>Gorgon SMG</label>
    <description>Typically wielded by the Kantus Priesthood or Theron Guard, The Gorgon is a dual magazine sidearm with a deadly burst fire capabilities. It is known for its complicated internal systems, which make use of the guns own recoil to load rounds into the chamber.</description>
    <techLevel>Industrial</techLevel>
	<graphicData>
      <texPath>Things/RWlocust/Weapons/GOW_GorgonSMG</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.35</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_Locustdronestwo</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>1002</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>8950</WorkToMake>
      <Mass>2.9</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.40</AccuracyShort>
      <AccuracyMedium>0.25</AccuracyMedium>
      <AccuracyLong>0.10</AccuracyLong>
      <RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>65</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
	<weaponTags>
	 <li>LocustElitesidearm</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_GOW_Gorgon</defaultProjectile>
		<burstShotCount>8</burstShotCount>
        <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
        <warmupTime>0.5</warmupTime>
        <range>22.9</range>
        <soundCast>Shot_GOW_Gorgon</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_GOW_Gorgon</defName>
    <label>gorgon round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>5</damageAmountBase>
	  <stoppingPower>0.5</stoppingPower>
      <speed>75</speed>
    </projectile>
  </ThingDef>

</Defs>