  <ThingDef ParentName="RWLocustArmorMachineableBase">
    <defName>Apparel_GOW_Kantus</defName>
    <label>Kantus Vestments</label>
    <description>Long robes made of hard leather for members of the Kantus Priesthood. These robes are designed more for religious purposes than battle despite Kantus Priests being a common sight in the front lines and during Rockworm hunts, resulting in them lacking protection.</description>
    <techLevel>Industrial</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>GOW_Locustkantus</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
	  <displayPriority>600</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/RWlocust/GOW_Kantus/GOW_Kantus</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>0.85</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>22750</WorkToMake>
      <MaxHitPoints>195</MaxHitPoints>
      <Mass>3.5</Mass>
      <Flammability>0.35</Flammability>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
      <Insulation_Cold>9</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
	  <MoveSpeed>0.15</MoveSpeed>
	  <SocialImpact>0.25</SocialImpact>
	  <PsychicSensitivityOffset>0.05</PsychicSensitivityOffset>
      <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.015</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <costList>
	  <Leather_Patch>85</Leather_Patch>
	  <Steel>20</Steel>
	  <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Legs</li>
      </bodyPartGroups>
	  <tags>
        <li>LocustKantus</li>
      </tags>
      <wornGraphicPath>Things/RWlocust/GOW_Kantus/GOW_Kantus</wornGraphicPath>
      <layers>
        <li>Middle</li>
		<li>Shell</li>
      </layers>
    </apparel>
	<modExtensions>
     <li Class="taranchuk_apparelgraphics.ApparelExtension">
      <hideBody>False</hideBody>
      <femaleBody>Female</femaleBody>
      <maleBody>Male</maleBody>
     </li>
    </modExtensions>
  </ThingDef>

</Defs>