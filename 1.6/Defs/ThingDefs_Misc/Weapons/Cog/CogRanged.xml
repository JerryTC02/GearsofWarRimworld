<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <ThingDef ParentName="RWCogBaseHumanMakeableGun">
    <defName>Gun_GOW_MK2Lancer</defName>
    <label>MK2 Lancer Assault Rifle</label>
    <description>The MK2 Lancer Assault Rifle was a direct upgrade to its predecessor, armed with an inbuilt chainsaw, increased accuracy, lower recoil, and magazine capacity. Designed by Professor Adam Jonathon Fenix during the first year of the Locust War, the second-generation Lancer soon became the standard weapon of the COG.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWcog/Weapons/GOW_Mark2LancerAssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_CogWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>2001</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>50000</WorkToMake>
      <Mass>5.8</Mass>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.25</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>115</Steel>
      <ComponentIndustrial>11</ComponentIndustrial>
    </costList>
    <weaponTags>
	 <li>COGlancer</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_MK2Lancer</defaultProjectile>
        <warmupTime>1</warmupTime>
        <range>28.9</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_GOW_MK2Lancer</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>chainsaw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>16</power>
		<soundMeleeHit>Shot_GOW_LancerHit</soundMeleeHit>
        <soundMeleeMiss>Shot_GOW_LancerMiss</soundMeleeMiss>
	    <extraMeleeDamages>
          <li>
            <def>Cut</def>
            <amount>4</amount>
            <chance>1</chance>
          </li>
		  <li>
            <def>Cut</def>
            <amount>4</amount>
            <chance>1</chance>
          </li>
		  <li>
            <def>Cut</def>
            <amount>4</amount>
            <chance>1</chance>
          </li>
		  <li>
            <def>Cut</def>
            <amount>4</amount>
            <chance>1</chance>
          </li>
        </extraMeleeDamages>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_MK2Lancer</defName>
    <label>lancer mk2 bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>65</speed>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="RWCogBaseHumanMakeableGun">
    <defName>Gun_GOW_RetroLancer</defName>
    <label>MK1 Lancer Assault Rifle</label>
    <description>The Mk I Lancer was once the standard infantry assault weapon for COG forces during the later years of the Pendulum Wars, undergoing very little change due to its reliability. Once renowned for its ability to strike fear into UIR forces with its infamous bayonet charges, the so called "Retro Lancer" was phased out early into the Locust Wars in favor of its chainsaw bearing successor.</description>
	<techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/RWcog/Weapons/GOW_RetroLancer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.05</drawSize>
    </graphicData>
    <equippedAngleOffset>45</equippedAngleOffset>
    <soundInteract>Interact_Rifle</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GOW_CogWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>2000</displayPriority>
    </recipeMaker>
    <statBases>
      <WorkToMake>41250</WorkToMake>
      <Mass>4.8</Mass>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <weaponTags>
	 <li>COGRetrolancer</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_MK2Lancer</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>26.9</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <soundCast>Shot_GOW_MK1Lancer</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>bayonet</label>
        <capacities>
          <li>Stab</li>
          <li>Cut</li>
        </capacities>
		<armorPenetration>0.25</armorPenetration>
        <power>19</power>
	    <soundMeleeHit>Shot_GOW_RetroLancerHit</soundMeleeHit>
        <soundMeleeMiss>Shot_GOW_RetroLancerMiss</soundMeleeMiss>
        <cooldownTime>2.0</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
